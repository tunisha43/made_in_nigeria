# Copy this file to .env.local and fill in real values once a Supabase
# project is provisioned. Until then, pages use hardcoded placeholder data
# instead of querying Supabase, so the app runs fine without these set.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, used for admin-privileged operations (e.g. the /admin
# verification queue actions). Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
